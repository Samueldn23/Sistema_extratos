{
  "version": 2,
  "buildCommand": "npm install",
  "outputDirectory": "publico",
  "installCommand": "npm install",
  "env": {
    "NODE_ENV": "production"
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "/publico/$1"
    }
  ]
}
